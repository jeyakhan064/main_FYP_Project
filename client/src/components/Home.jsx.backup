import { motion, AnimatePresence } from "framer-motion";
import { useSnapshot } from "valtio";
import { useNavigate } from "react-router-dom";
import state from "../store";
import { CustomButton } from "../components";
import {
  headContainerAnimation,
  headContentAnimation,
  headTextAnimation,
  slideAnimation,
} from "../config/motion";

const Home = () => {
  const snap = useSnapshot(state);
  const navigate = useNavigate();

  return (
    <AnimatePresence>
      {snap.intro && (
        <motion.section
          key="home"
          className="home items-center justify-center w-full h-screen bg-cover bg-center bg-no-repeat z-10  overflow-hidden "
          style={{
            width: "100%",
            backgroundImage: 'url("/assets/background.jpg")',
          }}
          {...slideAnimation("left")}
        >
          {/* Header */}
          <motion.header
            {...slideAnimation("down")}
            className="absolute top-6 left-6"
          >
            <img
              src="./threejs.png"
              alt="logo"
              className="w-10 h-10 object-contain"
            />
          </motion.header>

          {/* Main Content */}
          <motion.div
            className="home-content flex flex-col items-center justify-center text-center px-6 mx-auto mt-10 gap-6"
            {...headContainerAnimation}
          >
            <motion.div {...headTextAnimation}>
              <h1 className="text-5xl font-extrabold leading-tight text-gray-100">
                Make <br className="xl:block hidden" /> Your{" "}
                <br className="xl:block hidden" /> Own Brand
              </h1>
            </motion.div>

            <motion.div {...headContentAnimation}>
              <CustomButton
                type="filled"
                title="Let's Do It"
                handleClick={() => navigate("/explore")}
                customStyles="w-fit mx-auto px-6 py-3 font-bold text-sm"
              />
            </motion.div>
          </motion.div>
        </motion.section>
      )}
    </AnimatePresence>
  );
};

export default Home;
